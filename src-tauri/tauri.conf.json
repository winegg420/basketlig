{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Charazay 2.0",
  "version": "2.0.0",
  "identifier": "com.winegg.charazay",
  "build": {
    "frontendDist": "../dist-desktop",
    "beforeBuildCommand": "node tools/build-desktop.js",
    "beforeDevCommand": "node tools/build-desktop.js"
  },
  "app": {
    "windows": [
      {
        "title": "Charazay 2.0 — Basketbol Menajerliği",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
